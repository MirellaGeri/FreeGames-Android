<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:tool="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.DetailActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!--HERO-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">
                <VideoView
                    android:id="@+id/trailerVideoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:id="@+id/thumbnailImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:src="@drawable/ic_launcher_background"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <!--BASIC INFO-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">
                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tool:text="Game title"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_tertiaryFixed_highContrast"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:id="@+id/genreChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tool:text="Genre"
                        android:textColor="@color/md_theme_onPrimary"
                        android:clickable="false"
                        app:chipBackgroundColor="@color/md_theme_onPrimaryContainer"
                        app:ensureMinTouchTargetSize="false"
                        />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/platformPCImageView"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_platform_web"
                        android:visibility="gone"
                        app:tint="@color/md_theme_onPrimaryContainer"/>
                    <ImageView
                        android:id="@+id/platformWebImageView"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_platform_pc"
                        app:tint="@color/md_theme_onPrimaryContainer"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="16dp"/>
            <!--Description-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">
                <TextView
                    style="@style/FreeGames.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/description_label_detail"/>
                <TextView
                    android:id="@+id/descriptionTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    tools:text="Lorem ipsum"
                    android:ellipsize="end"
                    android:maxLines="5"/>
                <TextView
                    android:id="@+id/showMoreTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold|italic"
                    android:text="@string/detail_label_show_more"
                    android:textColor="@color/md_theme_primaryContainer_highContrast"/>
            </LinearLayout>
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="16dp"/>
            <!--SCREENSHORTS-->
            <TextView
                style="@style/FreeGames.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/screenshot_label_detail" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/screenshotsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:background="@color/md_theme_outlineVariant"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_screenshot" />
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="16dp" />
            <!--SYSTEM REQUIRMETS-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    style="@style/FreeGames.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/system_requirements_label_detail" />

                <TextView
                    style="@style/FreeGames.SystemRequirements.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_label_OS" />

                <TextView
                    android:id="@+id/systemRequirementsOsTextView"
                    style="@style/FreeGames.SystemRequirements.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Windows 11" />

                <TextView
                    style="@style/FreeGames.SystemRequirements.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_label_processor" />

                <TextView
                    android:id="@+id/systemRequirementsProcessorTextView"
                    style="@style/FreeGames.SystemRequirements.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Intel Core i3" />

                <TextView
                    style="@style/FreeGames.SystemRequirements.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_label_memory" />

                <TextView
                    android:id="@+id/systemRequirementsMemoryTextView"
                    style="@style/FreeGames.SystemRequirements.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="6 GB RAM" />

                <TextView
                    style="@style/FreeGames.SystemRequirements.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_label_graphics" />

                <TextView
                    android:id="@+id/systemRequirementsGraphicsTextView"
                    style="@style/FreeGames.SystemRequirements.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="NVIDIA GeForce GTX 600 series, AMD Radeon HD 7000 series" />

                <TextView
                    style="@style/FreeGames.SystemRequirements.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_label_storage" />

                <TextView
                    android:id="@+id/systemRequirementsStorageTextView"
                    style="@style/FreeGames.SystemRequirements.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="50 Gb" />


            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="64dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_background"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/detail_button_play"
            android:backgroundTint="@color/md_theme_tertiary_mediumContrast"/>

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/shareButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            app:icon="@drawable/ic_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTint="@color/md_theme_tertiary_mediumContrast"
            android:backgroundTint="@color/md_theme_primaryContainer"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>